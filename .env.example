# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# Never commit .env.local — it holds secrets.

# --- Database ---
# Neon Postgres connection string. Leave empty to use the local PGlite
# database at ./local.db (created by `npm run setup`).
# Example: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# --- BrickLink API (required for price lookups) ---
# Get these at https://www.bricklink.com/v2/api/register_consumer.page
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN=
BRICKLINK_TOKEN_SECRET=

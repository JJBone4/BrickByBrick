generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model CollectionItem {
  id            String    @id @default(cuid())
  itemNo        String
  itemType      String
  condition     String
  quantity      Int       @default(1)
  purchasePrice Float?
  purchaseDate  DateTime?
  notes         String?
  conditionTags String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([itemNo, itemType])
}

model PriceSnapshot {
  id         String   @id @default(cuid())
  itemNo     String
  itemType   String
  condition  String
  avgPrice   Float
  minPrice   Float
  maxPrice   Float
  qtySold    Int
  totalLots  Int
  capturedAt DateTime @default(now())

  @@index([itemNo, itemType, condition, capturedAt])
}

model CachedItem {
  itemNo       String
  itemType     String
  name         String
  imageUrl     String?
  categoryName String?
  lastFetched  DateTime @default(now())
  // Retirement (from Brickset): true = every set it came in has retired, false = still on sale,
  // null = unknown (no Brickset key, or no dates for its sets)
  retired          Boolean?
  retiredCheckedAt DateTime?

  @@id([itemNo, itemType])
}

// Individual sales from BrickLink's "sold" price guide (last ~6 months per fetch).
// Saved on every refresh so history keeps growing past BrickLink's rolling window.
model PriceSale {
  id            String   @id @default(cuid())
  itemNo        String
  itemType      String
  condition     String
  unitPrice     Float
  quantity      Int
  dateOrdered   DateTime
  sellerCountry String?
  buyerCountry  String?
  createdAt     DateTime @default(now())

  @@unique([itemNo, itemType, condition, dateOrdered, unitPrice, quantity])
  @@index([itemNo, itemType, condition, dateOrdered])
}
